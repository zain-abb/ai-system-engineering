\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Score Distribution Across Evaluators. Box plots show the distribution of scores for each quality dimension. Safety and hallucination detection show consistently high scores with minimal variance, while correctness exhibits more variability.}}{13}{figure.caption.15}\protected@file@percent }
