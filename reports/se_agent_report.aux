\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Scores by Difficulty Level. Performance remains relatively stable across difficulty levels, with hard tasks showing slightly more variance in correctness scores.}}{14}{figure.caption.18}\protected@file@percent }
